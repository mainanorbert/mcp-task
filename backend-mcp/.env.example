# ── OpenAI Agents SDK ────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── Meridian MCP server (Streamable HTTP) ────────────────────────
MCP_SERVER_URL=https://order-mcp-74afyau24q-uc.a.run.app/mcp
MCP_REQUEST_TIMEOUT_SECONDS=30
AGENT_MAX_TURNS=20

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO

# Session tokens (set a long random value in production)
SESSION_SIGNING_SECRET=

# ── HTTP / CORS ──────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Auth (Clerk). Set REQUIRE_AUTH=false to disable for local dev. ─
REQUIRE_AUTH=true
CLERK_JWKS_URL=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
